# Copy to `.env` and replace every value. NEVER commit `.env`.
# Use letters, digits, - and _ in passwords to avoid shell/URL quoting surprises.

MYSQL_DATABASE=employee_db
MYSQL_USER=employee_user
MYSQL_PASSWORD=replace_with_app_password
MYSQL_ROOT_PASSWORD=replace_with_root_password

# Host port for the web UI (only published port): http://localhost:8080
FRONTEND_PORT=8080
